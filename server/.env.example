# Copy this file to `.env` and fill in the values.
PORT=5000
NODE_ENV=development

# MongoDB Atlas (free tier) or local: mongodb://127.0.0.1:27017/ritik-portfolio
# Leave empty to run without a database (projects are served from the bundled data file,
# contact form submissions are only logged/emailed).
MONGODB_URI=

# Allowed browser origins for CORS (comma separated). Not needed when the server
# also serves the built client (single-service deploy).
CLIENT_URL=http://localhost:5173

# Optional: email notifications for the contact form (any SMTP: Gmail app-password, Brevo, Resend SMTP...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=rockykarak0@gmail.com
